     }
 }
 
+// (a ring's rows of positions 0 .. P - 1: rows 0 .. min(P, cap) - 1 hold them, whatever the order)
+void save_state(Drafter* d, int P, std::vector<uint8_t>& blob) {
+    const size_t KD = (size_t) d->KV * 128;
+    size_t tot = (size_t) d->C * 4;
+    for (auto& l : d->L) tot += (size_t) std::min(P, l.cap) * KD * (l.kc16 ? 2 : 4) * 2;
+    blob.resize(tot);
+    uint8_t* o = blob.data();
+    for (auto& l : d->L) {
+        const size_t b = (size_t) std::min(P, l.cap) * KD * (l.kc16 ? 2 : 4);
+        cu(cudaMemcpyAsync(o, l.kc16 ? (void*) l.kc16 : (void*) l.kc, b, cudaMemcpyDeviceToHost, d->s), "save");
+        cu(cudaMemcpyAsync(o + b, l.kc16 ? (void*) l.vc16 : (void*) l.vc, b, cudaMemcpyDeviceToHost, d->s), "save");
+        o += 2 * b;
+    }
+    cu(cudaMemcpyAsync(o, d->f_rnn, (size_t) d->C * 4, cudaMemcpyDeviceToHost, d->s), "save");
+    cu(cudaStreamSynchronize(d->s), "save");
+}
+
+void load_state(Drafter* d, int P, const std::vector<uint8_t>& blob) {
+    const size_t KD = (size_t) d->KV * 128;
+    const uint8_t* o = blob.data();
+    for (auto& l : d->L) {
+        const size_t b = (size_t) std::min(P, l.cap) * KD * (l.kc16 ? 2 : 4);
+        cu(cudaMemcpyAsync(l.kc16 ? (void*) l.kc16 : (void*) l.kc, o, b, cudaMemcpyHostToDevice, d->s), "load");
+        cu(cudaMemcpyAsync(l.kc16 ? (void*) l.vc16 : (void*) l.vc, o + b, b, cudaMemcpyHostToDevice, d->s), "load");
+        o += 2 * b;
+    }
+    cu(cudaMemcpyAsync(d->f_rnn, o, (size_t) d->C * 4, cudaMemcpyHostToDevice, d->s), "load");
+    cu(cudaStreamSynchronize(d->s), "load");
+}
+
 void set_f_rnn(Drafter* d, const float* taps, int ld, int row) {
     k::mix_rms(taps + (size_t) row * d->C, d->taps, (size_t) ld * d->C, 1, d->C, d->alpha + d->L.size() * d->taps, d->mk_dflare,
                d->eps, d->f_rnn, d->s);
