+    __syncthreads();
+    float4 o0[3] = {};
+#pragma unroll
+    for (int i = 0; i < MAX_N; ++i) {
+        if (i >= n) break;
+#pragma unroll
+        for (int qi = 0; qi < 3; ++qi) {
+            if (qi >= nq) break;
+            const float w_qi = sc[qi][i];
+            o0[qi].x += w_qi * xs[i].x;
+            o0[qi].y += w_qi * xs[i].y;
