+// Single-pass register-cached attn_res for C == 2304 (576 float4s -> 576 threads, 1 float4/thread):
+// reads each of the n <= MAX_N states ONCE from L2 into registers, eliminating the entire second pass.
+template <bool FUSED_RMS, int MAX_N>
+__global__ void attn_res_1pass_576_kernel(ResStates st, int n, const float* q, int nq, int T, int C, float res_eps,
+                                          float rms_eps, float* out, RmsOuts outs, size_t q_step, size_t o_step) {
+    q += blockIdx.y * q_step, out += blockIdx.y * o_step;
+    constexpr int NUM_WARPS = 576 / 32; // 18
+    __shared__ float sh_red[NUM_WARPS][kResMax * 4];
+    __shared__ float sc[3][kResMax];
+    __shared__ float rs_rms[3];
+    const int t = blockIdx.x, tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    float4 q0[3];
+    q0[0] = __ldg((const float4*) q + tid);
+    if (nq > 1) q0[1] = __ldg((const float4*) (q + C) + tid);
+    if (nq > 2) q0[2] = __ldg((const float4*) (q + 2 * C) + tid);
+    float4 xs[MAX_N];
+#pragma unroll
+    for (int i = 0; i < MAX_N; ++i) {
+        if (i < n) xs[i] = __ldg((const float4*) (st.st[i] + (size_t) t * C) + tid);
+    }
+#pragma unroll
+    for (int i = 0; i < MAX_N; ++i) {
+        if (i >= n) break;
+        const float4 xv = xs[i];
+        float sum_sq = xv.x * xv.x + xv.y * xv.y + xv.z * xv.z + xv.w * xv.w;
+        float qd0 = xv.x * q0[0].x + xv.y * q0[0].y + xv.z * q0[0].z + xv.w * q0[0].w;
+        float qd1 = nq > 1 ? (xv.x * q0[1].x + xv.y * q0[1].y + xv.z * q0[1].z + xv.w * q0[1].w) : 0.0f;
+        float qd2 = nq > 2 ? (xv.x * q0[2].x + xv.y * q0[2].y + xv.z * q0[2].z + xv.w * q0[2].w) : 0.0f;
+        sum_sq = wsum(sum_sq);
+        qd0 = wsum(qd0);
+        if (nq > 1) qd1 = wsum(qd1);
+        if (nq > 2) qd2 = wsum(qd2);
+        if (lane == 0) {
