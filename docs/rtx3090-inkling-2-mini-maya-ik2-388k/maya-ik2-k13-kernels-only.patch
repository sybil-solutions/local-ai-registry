+    } else {
+#pragma unroll
+        for (int qi = 0; qi < 3; ++qi) {
+            if (qi >= nq) break;
+            float sq = o0[qi].x * o0[qi].x + o0[qi].y * o0[qi].y + o0[qi].z * o0[qi].z + o0[qi].w * o0[qi].w;
+            sq = wsum(sq);
