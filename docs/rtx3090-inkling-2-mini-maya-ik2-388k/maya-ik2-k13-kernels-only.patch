+        }
+        __syncthreads();
+        if (warp == 0) {
+#pragma unroll
+            for (int qi = 0; qi < 3; ++qi) {
+                if (qi >= nq) break;
+                float s_tot = (lane < NUM_WARPS) ? sh_red[lane][qi] : 0.0f;
