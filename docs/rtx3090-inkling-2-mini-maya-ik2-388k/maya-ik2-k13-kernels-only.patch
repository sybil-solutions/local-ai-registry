+// Single-pass register-cached RMSNorm for D == 2304 (576 threads = 18 warps, 1 float4/thread, 1 __syncthreads).
+template <bool WRITE_F16, bool WRITE_F32>
+__global__ void rms_1pass_576_kernel(const float* x, const float* __restrict__ w, float eps,
+                                     uint16_t* __restrict__ y16, float* y32) {
+    __shared__ float sh[18];
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    const size_t row_off = (size_t) blockIdx.x * 576;
+    const float4 v = __ldg((const float4*) x + row_off + tid);
+    float a = wsum(v.x * v.x + v.y * v.y + v.z * v.z + v.w * v.w);
+    if (lane == 0) sh[warp] = a;
+    __syncthreads();
+    if (warp == 0) {
+        float s = (lane < 18) ? sh[lane] : 0.0f;
+        s = wsum(s);
+        if (lane == 0) sh[0] = rsqrtf(s / 2304.0f + eps);
+    }
+    __syncthreads();
+    const float rs = sh[0];
+    const float4 ww = w ? __ldg((const float4*) w + tid) : make_float4(1.0f, 1.0f, 1.0f, 1.0f);
+    const float r0 = v.x * rs * ww.x, r1 = v.y * rs * ww.y, r2 = v.z * rs * ww.z, r3 = v.w * rs * ww.w;
+    if (WRITE_F32) ((float4*) y32)[row_off + tid] = make_float4(r0, r1, r2, r3);
+    if (WRITE_F16) ((uint2*) y16)[row_off + tid] = make_uint2(f2_to_u32(r0, r1), f2_to_u32(r2, r3));
+}
