+           (m->type == GGML_TYPE_F16 || m->type == GGML_TYPE_F32) && m->ne[0] == n_kv && m->ne[1] == T && m->nb[0] == ggml_type_size(m->type) &&
+           ggml_is_contiguous(op) && op->ne[3] == 1;
