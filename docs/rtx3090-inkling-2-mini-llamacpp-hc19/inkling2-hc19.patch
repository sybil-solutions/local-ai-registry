+// hc: fused elementwise chains of the Inkling2 graph (see inkling.cuh for the matched patterns)
+#include "inkling.cuh"
+
+// ---------------------------------------------------------------------------------------------
+// row L2 clip: y = x (* s); n = sqrt(sum(y^2))*a + b; f = clamp(c/n, lo, hi); out = y*f
+// x: contiguous [ne0, ne1, ne2, ne3], s: [ne0, ne1] broadcast over ne2/ne3 (optional)
+template <int NE0>
+static __global__ void k_inkling_clip(const float * __restrict__ x, const float * __restrict__ s, float * __restrict__ dst,
+                                      const int64_t n_rows, const int ne0, const int64_t s_rows,
+                                      const float a, const float b, const float c, const float lo, const float hi) {
+    const int64_t row = (int64_t) blockIdx.x*blockDim.y + threadIdx.y;
+    if (row >= n_rows) {
+        return;
+    }
+    const int lane = threadIdx.x;
+    const float * xr = x + row*ne0;
+    const float * sr = s ? s + (row % s_rows)*ne0 : nullptr;
+    constexpr int PER = NE0 > 0 ? (NE0 + WARP_SIZE - 1)/WARP_SIZE : 8;
+    float v[PER];
+    float sum = 0.0f;
+#pragma unroll
+    for (int k = 0; k < PER; ++k) {
+        const int i = lane + k*WARP_SIZE;
+        float t = 0.0f;
+        if (i < ne0) {
+            t = xr[i];
+            if (sr) {
+                t *= sr[i];
+            }
+        }
+        v[k] = t;
+        sum += t*t;
+    }
+    sum = warp_reduce_sum(sum);
+    const float n = sqrtf(sum)*a + b;
+    const float f = fminf(fmaxf(c/n, lo), hi);
+    float * dr = dst + row*ne0;
+#pragma unroll
+    for (int k = 0; k < PER; ++k) {
+        const int i = lane + k*WARP_SIZE;
+        if (i < ne0) {
+            dr[i] = v[k]*f;
+        }
+    }
+}
+
+void ggml_cuda_op_inkling_clip(ggml_backend_cuda_context & ctx, const ggml_tensor * x, const ggml_tensor * s,
+                               float a, float b, float c, float lo, float hi, ggml_tensor * dst) {
+    const int ne0 = (int) x->ne[0];
+    const int64_t n_rows = ggml_nrows(x);
+    const int64_t s_rows = s ? ggml_nrows(s) : 1;
+    const dim3 block(WARP_SIZE, 4, 1);
+    const dim3 grid((unsigned) ((n_rows + 3)/4), 1, 1);
+    cudaStream_t st = ctx.stream();
+    const float * sp = s ? (const float *) s->data : nullptr;
+    if (ne0 <= 32) {
+        k_inkling_clip<32><<<grid, block, 0, st>>>((const float *) x->data, sp, (float *) dst->data, n_rows, ne0, s_rows, a, b, c, lo, hi);
+    } else if (ne0 <= 128) {
+        k_inkling_clip<128><<<grid, block, 0, st>>>((const float *) x->data, sp, (float *) dst->data, n_rows, ne0, s_rows, a, b, c, lo, hi);
+    } else {
+        k_inkling_clip<256><<<grid, block, 0, st>>>((const float *) x->data, sp, (float *) dst->data, n_rows, ne0, s_rows, a, b, c, lo, hi);
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// loop controller tail: out = (tanh(F)*fs + fb)*cur + tanh(G)*msg   (all same shape, contiguous)
+static __global__ void k_inkling_control(const float * __restrict__ F, const float * __restrict__ cur,
+                                         const float * __restrict__ G, const float * __restrict__ msg,
+                                         float * __restrict__ dst, const int64_t n, const float fs, const float fb) {
+    const int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+    dst[i] = (tanhf(F[i])*fs + fb)*cur[i] + tanhf(G[i])*msg[i];
+}
+
+void ggml_cuda_op_inkling_control(ggml_backend_cuda_context & ctx, const ggml_tensor * F, const ggml_tensor * cur,
+                                  const ggml_tensor * G, const ggml_tensor * msg, float fs, float fb, ggml_tensor * dst) {
+    const int64_t n = ggml_nelements(dst);
+    const int bs = 256;
+    k_inkling_control<<<(unsigned) ((n + bs - 1)/bs), bs, 0, ctx.stream()>>>((const float *) F->data, (const float *) cur->data,
+            (const float *) G->data, (const float *) msg->data, (float *) dst->data, n, fs, fb);
+}
+
+// ---------------------------------------------------------------------------------------------
+// out = (a + b)*s + bias   (same shape, contiguous)
+static __global__ void k_inkling_add_scale(const float * __restrict__ a, const float * __restrict__ b, float * __restrict__ dst,
+                                           const int64_t n, const float s, const float bias) {
+    const int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+    dst[i] = (a[i] + b[i])*s + bias;
+}
+
+void ggml_cuda_op_inkling_add_scale(ggml_backend_cuda_context & ctx, const ggml_tensor * a, const ggml_tensor * b,
+                                    float s, float bias, ggml_tensor * dst) {
+    const int64_t n = ggml_nelements(dst);
+    const int bs = 256;
+    k_inkling_add_scale<<<(unsigned) ((n + bs - 1)/bs), bs, 0, ctx.stream()>>>((const float *) a->data, (const float *) b->data,
+            (float *) dst->data, n, s, bias);
+}
+
+// ---------------------------------------------------------------------------------------------
+// causal short conv (d_conv 4) with residual and scale, plus the conv-state store:
+//   win = [past(3) | x(n_t)] per channel; y_t = sum_k w[k]*win[t+k]; out_t = (x_t + y_t)*s + b; state = last 3 of win
+// past: [3, C, S] (strides in floats), x: contiguous [C, n_t, S], w: [4, C] contiguous, out like x, state: contiguous [3, C, S]
+static __global__ void k_inkling_conv(const float * __restrict__ past, const int64_t past_s1, const int64_t past_s2,
+                                      const float * __restrict__ x, const float * __restrict__ w,
+                                      float * __restrict__ out, float * __restrict__ state, const int64_t state_s,
+                                      const int C, const int n_t, const int S, const float s, const float b) {
+    const int c  = blockIdx.x*blockDim.x + threadIdx.x;
+    const int sq = blockIdx.y;
+    if (c >= C || sq >= S) {
+        return;
+    }
+    const float w0 = w[4*c + 0], w1 = w[4*c + 1], w2 = w[4*c + 2], w3 = w[4*c + 3];
+    const float * pp = past + c*past_s1 + sq*past_s2;
+    float p0 = pp[0], p1 = pp[1], p2 = pp[2];
+    const float * xs = x   + (int64_t) sq*n_t*C + c;
+    float       * os = out + (int64_t) sq*n_t*C + c;
+    for (int t = 0; t < n_t; ++t) {
+        const float xv = xs[(int64_t) t*C];
+        const float y  = w0*p0 + w1*p1 + w2*p2 + w3*xv;
+        os[(int64_t) t*C] = (xv + y)*s + b;
+        p0 = p1; p1 = p2; p2 = xv;
+    }
+    float * st = state + sq*state_s + (int64_t) c*3;
+    st[0] = p0; st[1] = p1; st[2] = p2;
+}
+
+void ggml_cuda_op_inkling_conv(ggml_backend_cuda_context & ctx, const ggml_tensor * past, const ggml_tensor * x,
+                               const ggml_tensor * w, float s, float b, ggml_tensor * out, ggml_tensor * state) {
+    const int C   = (int) past->ne[1];
+    const int S   = (int) past->ne[2];
+    const int n_t = (int) (ggml_nelements(x)/((int64_t) C*S));
+    const dim3 block(128, 1, 1);
+    const dim3 grid((C + 127)/128, S, 1);
+    k_inkling_conv<<<grid, block, 0, ctx.stream()>>>((const float *) past->data, past->nb[1]/sizeof(float), past->nb[2]/sizeof(float),
+            (const float *) x->data, (const float *) w->data, (float *) out->data, (float *) state->data,
+            state->ne[1] > 1 ? state->nb[1]/sizeof(float) : (int64_t) 3*C, C, n_t, S, s, b);
+}
+
+// ---------------------------------------------------------------------------------------------
+// depth mix: cur_n = rms_norm(cur); states = [stack(nb) | cur_n]; p = softmax(scale * q^T states); out = states p
+// cur: [E, T] rows contiguous, stack: [E, nb, T] contiguous (may be null when nb == 0), query: [E, nq] contiguous,
+// out: [E, nq, T] contiguous. One block per token.
+#define INKLING_MIX_MAX_S 16
+#define INKLING_MIX_MAX_Q 4
+static __global__ void k_inkling_mix(const float * __restrict__ cur, const float * __restrict__ stack, const float * __restrict__ query,
+                                     float * __restrict__ out, const int E, const int nb, const int nq,
+                                     const float eps, const float scale) {
+    // phase 1: every warp takes (q, j) dot products (j == nb uses the raw cur) or the sum of squares of cur
+    // phase 2: softmax (the cur score gets the rms factor), phase 3: weighted sum
+    __shared__ float p[INKLING_MIX_MAX_Q][INKLING_MIX_MAX_S];
+    __shared__ float rn_s;
+    const int t = blockIdx.x;
+    const int tid = threadIdx.x, nth = blockDim.x;
+    const int lane = tid % WARP_SIZE, wid = tid / WARP_SIZE, nw = nth / WARP_SIZE;
+    const int ns = nb + 1;
+    const int E4 = E/4;
+    const float4 * cr = (const float4 *) (cur + (int64_t) t*E);
+    const float4 * sk = stack ? (const float4 *) (stack + (int64_t) t*nb*E) : nullptr;
+    const int n_task = nq*ns + 1;
+    for (int task = wid; task < n_task; task += nw) {
+        float d0 = 0.0f, d1 = 0.0f;
+        if (task == nq*ns) {
+            for (int e = lane; e < E4; e += 2*WARP_SIZE) {
+                const float4 v = cr[e];
+                d0 += v.x*v.x + v.y*v.y + v.z*v.z + v.w*v.w;
+                if (e + WARP_SIZE < E4) { const float4 u = cr[e + WARP_SIZE]; d1 += u.x*u.x + u.y*u.y + u.z*u.z + u.w*u.w; }
+            }
+            d0 = warp_reduce_sum(d0 + d1);
+            if (lane == 0) rn_s = rsqrtf(d0/E + eps);
+        } else {
+            const int q = task / ns, j = task % ns;
+            const float4 * qv = (const float4 *) (query + (int64_t) q*E);
+            const float4 * sv = j < nb ? sk + (int64_t) j*E4 : cr;
+            for (int e = lane; e < E4; e += 2*WARP_SIZE) {
+                const float4 a = qv[e], b = sv[e];
+                d0 += a.x*b.x + a.y*b.y + a.z*b.z + a.w*b.w;
+                if (e + WARP_SIZE < E4) {
+                    const float4 a2 = qv[e + WARP_SIZE], b2 = sv[e + WARP_SIZE];
+                    d1 += a2.x*b2.x + a2.y*b2.y + a2.z*b2.z + a2.w*b2.w;
+                }
+            }
+            d0 = warp_reduce_sum(d0 + d1);
+            if (lane == 0) p[q][j] = d0;
+        }
+    }
+    __syncthreads();
+    const float rn = rn_s;
+    if (tid < nq) {
+        p[tid][nb] *= rn;
+        float m = -INFINITY;
+        for (int j = 0; j < ns; ++j) { p[tid][j] *= scale; m = fmaxf(m, p[tid][j]); }
+        float sum = 0.0f;
+        for (int j = 0; j < ns; ++j) { const float v = expf(p[tid][j] - m); p[tid][j] = v; sum += v; }
+        const float inv = 1.0f/sum;
+        for (int j = 0; j < nb; ++j) p[tid][j] *= inv;
+        p[tid][nb] *= inv*rn; // applied to the raw cur
+    }
+    __syncthreads();
+    float4 * ot = (float4 *) (out + (int64_t) t*nq*E);
+    for (int e = tid; e < E4; e += nth) {
+        float4 acc[INKLING_MIX_MAX_Q];
+        const float4 c = cr[e];
+#pragma unroll
+        for (int q = 0; q < INKLING_MIX_MAX_Q; ++q) {
+            const float w = q < nq ? p[q][nb] : 0.0f;
+            acc[q] = make_float4(w*c.x, w*c.y, w*c.z, w*c.w);
+        }
+        for (int j = 0; j < nb; ++j) {
+            const float4 v = sk[(int64_t) j*E4 + e];
+#pragma unroll
+            for (int q = 0; q < INKLING_MIX_MAX_Q; ++q) {
+                if (q < nq) { const float w = p[q][j]; acc[q].x += w*v.x; acc[q].y += w*v.y; acc[q].z += w*v.z; acc[q].w += w*v.w; }
+            }
+        }
+#pragma unroll
+        for (int q = 0; q < INKLING_MIX_MAX_Q; ++q) if (q < nq) ot[(int64_t) q*E4 + e] = acc[q];
+    }
+}
+
+// split variant for few tokens (decode): the one-block-per-token kernel runs on T SMs only.
+// k1: grid (T, C) partial dots / sum of squares over an E chunk; k2: grid (T, C) every block reduces the partials,
+// redoes the tiny softmax and writes its E chunk.
+#define INKLING_MIX_CHUNKS 8
+static __global__ void k_inkling_mix_part(const float * __restrict__ cur, const float * __restrict__ stack, const float * __restrict__ query,
+                                          float * __restrict__ part, const int E, const int nb, const int nq) {
+    const int t = blockIdx.x, c = blockIdx.y, C = gridDim.y;
+    const int lane = threadIdx.x % WARP_SIZE, wid = threadIdx.x / WARP_SIZE, nw = blockDim.x / WARP_SIZE;
+    const int ns = nb + 1, n_task = nq*ns + 1;
+    const int E4 = E/4, per = (E4 + C - 1)/C, e0 = c*per, e1 = min(E4, e0 + per);
+    const float4 * cr = (const float4 *) (cur + (int64_t) t*E);
+    const float4 * sk = stack ? (const float4 *) (stack + (int64_t) t*nb*E) : nullptr;
+    for (int task = wid; task < n_task; task += nw) {
+        float d = 0.0f;
+        if (task == nq*ns) {
+            for (int e = e0 + lane; e < e1; e += WARP_SIZE) { const float4 v = cr[e]; d += v.x*v.x + v.y*v.y + v.z*v.z + v.w*v.w; }
+        } else {
+            const int q = task / ns, j = task % ns;
+            const float4 * qv = (const float4 *) (query + (int64_t) q*E);
+            const float4 * sv = j < nb ? sk + (int64_t) j*E4 : cr;
+            for (int e = e0 + lane; e < e1; e += WARP_SIZE) { const float4 a = qv[e], b = sv[e]; d += a.x*b.x + a.y*b.y + a.z*b.z + a.w*b.w; }
+        }
+        d = warp_reduce_sum(d);
+        if (lane == 0) part[((int64_t) t*C + c)*n_task + task] = d;
+    }
+}
+
+static __global__ void k_inkling_mix_out(const float * __restrict__ cur, const float * __restrict__ stack, const float * __restrict__ part,
+                                         float * __restrict__ out, const int E, const int nb, const int nq, const float eps, const float scale) {
+    __shared__ float p[INKLING_MIX_MAX_Q][INKLING_MIX_MAX_S];
+    __shared__ float rn_s;
+    const int t = blockIdx.x, c = blockIdx.y, C = gridDim.y;
+    const int tid = threadIdx.x;
+    const int ns = nb + 1, n_task = nq*ns + 1;
+    const float * pt = part + (int64_t) t*C*n_task;
+    for (int task = tid; task < n_task; task += blockDim.x) {
+        float d = 0.0f;
+        for (int k = 0; k < C; ++k) d += pt[k*n_task + task];
+        if (task == nq*ns) rn_s = rsqrtf(d/E + eps); else p[task / ns][task % ns] = d;
+    }
+    __syncthreads();
+    const float rn = rn_s;
+    if (tid < nq) {
+        p[tid][nb] *= rn;
+        float m = -INFINITY;
+        for (int j = 0; j < ns; ++j) { p[tid][j] *= scale; m = fmaxf(m, p[tid][j]); }
+        float sum = 0.0f;
+        for (int j = 0; j < ns; ++j) { const float v = expf(p[tid][j] - m); p[tid][j] = v; sum += v; }
+        const float inv = 1.0f/sum;
+        for (int j = 0; j < nb; ++j) p[tid][j] *= inv;
+        p[tid][nb] *= inv*rn;
+    }
+    __syncthreads();
+    const int E4 = E/4, per = (E4 + C - 1)/C, e0 = c*per, e1 = min(E4, e0 + per);
+    const float4 * cr = (const float4 *) (cur + (int64_t) t*E);
+    const float4 * sk = stack ? (const float4 *) (stack + (int64_t) t*nb*E) : nullptr;
+    float4 * ot = (float4 *) (out + (int64_t) t*nq*E);
+    for (int e = e0 + tid; e < e1; e += blockDim.x) {
+        float4 acc[INKLING_MIX_MAX_Q];
+        const float4 cv = cr[e];
+#pragma unroll
+        for (int q = 0; q < INKLING_MIX_MAX_Q; ++q) {
+            const float w = q < nq ? p[q][nb] : 0.0f;
+            acc[q] = make_float4(w*cv.x, w*cv.y, w*cv.z, w*cv.w);
+        }
+        for (int j = 0; j < nb; ++j) {
+            const float4 v = sk[(int64_t) j*E4 + e];
+#pragma unroll
+            for (int q = 0; q < INKLING_MIX_MAX_Q; ++q) {
+                if (q < nq) { const float w = p[q][j]; acc[q].x += w*v.x; acc[q].y += w*v.y; acc[q].z += w*v.z; acc[q].w += w*v.w; }
+            }
+        }
+#pragma unroll
+        for (int q = 0; q < INKLING_MIX_MAX_Q; ++q) if (q < nq) ot[(int64_t) q*E4 + e] = acc[q];
+    }
+}
+
+bool ggml_cuda_inkling_mix_ok(int nb, int nq) {
+    return nb + 1 <= INKLING_MIX_MAX_S && nq <= INKLING_MIX_MAX_Q;
+}
+
+void ggml_cuda_op_inkling_mix(ggml_backend_cuda_context & ctx, const ggml_tensor * cur, const ggml_tensor * stack,
+                              const ggml_tensor * query, float eps, float scale, ggml_tensor * out) {
+    const int E  = (int) cur->ne[0];
+    const int T  = (int) (ggml_nelements(cur)/E);
+    const int nb = stack ? (int) stack->ne[1] : 0;
+    const int nq = (int) query->ne[1];
+    GGML_ASSERT(E % 4 == 0);
+    static const int split_max_t = getenv("GGML_CUDA_HC_MIX_SPLIT_T") ? atoi(getenv("GGML_CUDA_HC_MIX_SPLIT_T")) : 8;
+    if (T <= split_max_t) {
+        const int C = INKLING_MIX_CHUNKS, n_task = nq*(nb + 1) + 1;
+        ggml_cuda_pool_alloc<float> part(ctx.pool(), (size_t) T*C*n_task);
+        const dim3 grid(T, C, 1);
+        k_inkling_mix_part<<<grid, 256, 0, ctx.stream()>>>((const float *) cur->data, stack ? (const float *) stack->data : nullptr,
+                (const float *) query->data, part.get(), E, nb, nq);
+        k_inkling_mix_out<<<grid, 128, 0, ctx.stream()>>>((const float *) cur->data, stack ? (const float *) stack->data : nullptr,
+                part.get(), (float *) out->data, E, nb, nq, eps, scale);
+        return;
+    }
+    k_inkling_mix<<<T, 1024, 0, ctx.stream()>>>((const float *) cur->data, stack ? (const float *) stack->data : nullptr,
+            (const float *) query->data, (float *) out->data, E, nb, nq, eps, scale);
+}
+
+// ---------------------------------------------------------------------------------------------
+// MoE SiTU with the per-expert scale: gu: [2*F, n_e, T] contiguous, es: [1, n_e, T] contiguous (expert scale per slot)
+//   g = gu[i]*es, u = gu[F+i]*es; out = (s2*tanh(s1*g + b1) + b2)*sigmoid(g) * (s4*tanh(s3*u + b3) + b4)
+static __global__ void k_inkling_situ(const float * __restrict__ gu, const float * __restrict__ es, float * __restrict__ out,
+                                      const int F, const int64_t n_rows,
+                                      const float s1, const float b1, const float s2, const float b2,
+                                      const float s3, const float b3, const float s4, const float b4, const bool has_up) {
+    const int64_t idx = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (idx >= n_rows*F) {
+        return;
+    }
+    const int64_t r = idx / F;
+    const int     i = (int) (idx % F);
+    const float sc = es ? es[r] : 1.0f;
+    const float g = gu[r*2*F + i]*sc;
+    float u = gu[r*2*F + F + i]*sc;
+    if (has_up) {
+        u = s4*tanhf(s3*u + b3) + b4;
+    }
+    const float a = (s2*tanhf(s1*g + b1) + b2)/(1.0f + expf(-g));
+    out[idx] = a*u;
+}
+
+void ggml_cuda_op_inkling_situ(ggml_backend_cuda_context & ctx, const ggml_tensor * gu, const ggml_tensor * es,
+                               const float * p, bool has_up, ggml_tensor * out) {
+    const int F = (int) out->ne[0];
+    const int64_t n_rows = ggml_nrows(out);
+    const int64_t n = n_rows*F;
+    const int bs = 256;
+    k_inkling_situ<<<(unsigned) ((n + bs - 1)/bs), bs, 0, ctx.stream()>>>((const float *) gu->data, es ? (const float *) es->data : nullptr,
+            (float *) out->data, F, n_rows, p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7], has_up);
+}
+
+// ---------------------------------------------------------------------------------------------
+// relative-position bias folded into the per-head F16 flash-attention mask:
+//   out[kv, t, h] = sum_r pb[r, rp[kv, t]]*R[r, h, t] - sink[h, t] + mask[kv, t]
+// pb: [n_rel, n_pos] contiguous, R: [n_rel, H, T] contiguous, sink: [H, T] contiguous, rp: I32 [n_kv, T] contiguous,
+// mask: [n_kv, T] with row stride mask_s1 (elements), F16 or F32; out: F16 [n_kv, T, H] contiguous
+template <typename mask_t, int NREL>
+static __global__ void k_inkling_relmask(const float * __restrict__ pb, const float * __restrict__ R, const float * __restrict__ sink,
+                                         const int32_t * __restrict__ rp, const mask_t * __restrict__ mask, const int64_t mask_s1,
+                                         half * __restrict__ out, const int n_rel, const int n_kv, const int T, const int H) {
+    // one block per (t, h): R row in registers, the table row of each cell read as float4
+    const int t = blockIdx.x;
+    const int h = blockIdx.y;
+    const float4 * rr4 = (const float4 *) (R + ((int64_t) t*H + h)*NREL);
+    float4 rv[NREL/4];
+#pragma unroll
+    for (int k = 0; k < NREL/4; ++k) rv[k] = rr4[k];
+    const float sk = sink[(int64_t) t*H + h];
+    const int32_t * rpt = rp + (int64_t) t*n_kv;
+    const mask_t  * mt  = mask + (int64_t) t*mask_s1;
+    half * ot = out + ((int64_t) h*T + t)*n_kv;
+    for (int kv = threadIdx.x; kv < n_kv; kv += blockDim.x) {
+        const float4 * pr = (const float4 *) (pb + (int64_t) rpt[kv]*NREL);
+        float acc = 0.0f;
+#pragma unroll
+        for (int k = 0; k < NREL/4; ++k) {
+            const float4 a = __ldg(pr + k);
+            acc += a.x*rv[k].x + a.y*rv[k].y + a.z*rv[k].z + a.w*rv[k].w;
+        }
+        ot[kv] = __float2half(acc - sk + (float) mt[kv]);
+    }
+    GGML_UNUSED(n_rel);
+}
+
+void ggml_cuda_op_inkling_relmask(ggml_backend_cuda_context & ctx, const ggml_tensor * pb, const ggml_tensor * R, const ggml_tensor * sink,
+                                  const ggml_tensor * rp, const ggml_tensor * mask, ggml_tensor * out) {
+    const int n_rel = (int) pb->ne[0];
+    const int n_kv  = (int) out->ne[0];
+    const int T     = (int) out->ne[1];
+    const int H     = (int) out->ne[2];
+    GGML_ASSERT(n_rel == 16);
+    const dim3 block(n_kv >= 512 ? 256 : 128, 1, 1);
+    const dim3 grid(T, H, 1);
+    const int64_t ms1 = mask->nb[1]/ggml_element_size(mask);
+    if (mask->type == GGML_TYPE_F16) {
+        k_inkling_relmask<half, 16><<<grid, block, 0, ctx.stream()>>>((const float *) pb->data, (const float *) R->data, (const float *) sink->data,
