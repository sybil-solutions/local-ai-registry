{
  "id": "sglang-exl3-offload-multiarch",
  "engine": "sglang",
  "about": "SGLang 0.5.20 with EXL3 kernels and trellis-serve's MoE offload (the sglang-exl3-flashnext-multiarch image: trellis-serve rtx30-offload @ 2e27422 compiled for sm_86, sm_89 and sm_120, so RTX 30-, 40- and 50-series cards): routed experts in page-locked host RAM behind a GPU expert cache, so MoE models larger than the card run on it. K=2/3/4 experts (Qwen3.8-Flash-Next 2.05bpw on 8-10 GB cards, 3.05bpw on 12 GB and up). Settings: cache = permanent expert cache GB (auto: fit after an 8.26 GB reserve, which is 0 on cards <= 12 GB); elastic = extra cache GB taken at decode and handed back for each prefill; cpu_tier = 1 computes a share of K=3 decode misses on the CPU (cpu_threads, 0 = physical cores - 2); parts / subchunk = prefill staging parts and GEMM sub-chunk tokens; ngram_ram = n-gram RAM row cache GB; hc_int8 = row for int8 hyper-connection weights; override = --json-model-override-args ({\"language_model_only\":true} = text only, no ViT weights); pool = KV token pool (0: ctx x seqs + 1024 x seqs); mamba = mamba state cache size (>= 5 per request); alloc = PYTORCH_CUDA_ALLOC_CONF; kv_bits = exllamav3-quantized QSA KV bits (0: the kv dtype as given; the image's own default is 5)",
  "image": "ghcr.io/sybil-solutions/sglang-exl3-flashnext-multiarch@sha256:fc147f4dd42b89d76406eab482cb3f925346c41e74d983e2ff1dcb721f6d4a2f",
  "provenance": "https://github.com/sybil-solutions/local-ai-images/actions/runs/38938524713",
  "backend": "nvidia",
  "min_cuda": 13.0,
  "port": 30000,
  "entrypoint": "/opt/entrypoint.sh",
  "args": [
    "python3",
    "-m",
    "sglang.launch_server",
    "--model-path",
    "/models/${name}",
    "--quantization",
    "exl3",
    "--trust-remote-code",
    "--host",
    "0.0.0.0",
    "--port",
    "30000",
    "--served-model-name",
    "${name}",
    "--disable-shared-experts-fusion",
    "--context-length",
    "${ctx}",
    "--mem-fraction-static",
    "${mem}",
    "--kv-cache-dtype",
    "${kv}",
    "--max-running-requests",
    "${seqs}",
    "--chunked-prefill-size",
    "${chunk}",
    "--cuda-graph-max-bs-decode",
    "${graphs}",
    "--cuda-graph-backend-prefill",
    "disabled",
    "--max-mamba-cache-size",
    "${mamba}",
    "--max-total-tokens",
    "${cache_tokens}",
    "--json-model-override-args=${override}",
    "--reasoning-parser",
    "${think}",
    "--tool-call-parser",
    "${tools}",
    "${extra}"
  ],
  "env": {
    "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
    "HF_HUB_OFFLINE": "1",
    "SGLANG_EXL3_MODEL_PATH": "/models/${name}",
    "SGLANG_EXL3_MOE_OFFLOAD": "gpu_cache",
    "SGLANG_EXL3_EXPERT_CACHE_GB": "${cache}",
    "SGLANG_EXL3_OFFLOAD_ELASTIC_GB": "${elastic}",
    "SGLANG_EXL3_OFFLOAD_CPU_TIER": "${cpu_tier}",
    "SGLANG_EXL3_CPU_TIER_THREADS": "${cpu_threads}",
    "EXL3_MOE_CPU_THREADS": "${threads}",
    "SGLANG_EXL3_EMBED_HOST": "1",
    "SGLANG_EXL3_OFFLOAD_STAGING_PARTS": "${parts}",
    "SGLANG_EXL3_OFFLOAD_FUSED": "1",
    "SGLANG_EXL3_OFFLOAD_COMPACT_PARTS": "1",
    "SGLANG_EXL3_MOE_PREFILL_FP16_ACC": "1",
    "SGLANG_EXL3_NGRAM_TIER": "${ngram}",
    "SGLANG_EXL3_VISION": "${vision_env}",
    "SGLANG_EXL3_MM_FAST_CPU": "1",
    "SGLANG_EXL3_VIT_SDPA": "1",
    "SGLANG_EXL3_VIT_MLP_CHUNK": "8192",
    "SGLANG_EXL3_OFFLOAD_PREFILL_SUBCHUNK": "${subchunk}",
    "SGLANG_EXL3_NGRAM_RAM_GB": "${ngram_ram}",
    "SGLANG_EXL3_HC_INT8": "${hc_int8}",
    "PYTORCH_CUDA_ALLOC_CONF": "${alloc}",
    "SGLANG_EXL3_KV_BITS": "${kv_bits}"
  },
  "shm": "16g",
  "weights_at": "/models/${name}",
  "needs": {
    "host_ram_gb": "${ram}",
    "disk_gb": "${disk}",
    "fast_storage": "nvme"
  },
  "defaults": {
    "ctx": 65536,
    "seqs": 1,
    "mem": 0.85,
    "kv": "fp8_e4m3",
    "chunk": 4096,
    "graphs": 4,
    "mamba": 8,
    "tools": "qwen3_coder",
    "think": "qwen3",
    "vision": false,
    "vision_env": 0,
    "extra": "",
    "cache": "auto",
    "threads": 8,
    "ngram": "nvme",
    "ram": 75,
    "disk": 90,
    "pool": 0,
    "elastic": 0,
    "cpu_tier": 0,
    "cpu_threads": 0,
    "parts": 4,
    "subchunk": 1073741824,
    "ngram_ram": 8,
    "hc_int8": "0",
    "override": "{}",
    "alloc": "expandable_segments:False",
    "kv_bits": 0
  }
}
