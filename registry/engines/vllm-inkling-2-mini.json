{
  "id": "vllm-inkling-2-mini",
  "engine": "vllm",
  "about": "vLLM built for Inkling 2 Mini (vllm/vllm-openai:inkling-2-mini, 2026-11-20), the upstream image until a vLLM release includes the looped architecture; inkling tool and reasoning parsers",
  "image": "vllm/vllm-openai:inkling-2-mini@sha256:c2dc759f5984f69c1e2418c6af7c26eb756f5ed2a8934c768ae1253645d1449e",
  "backend": "nvidia",
  "min_cuda": 12.9,
  "port": 8000,
  "entrypoint": "vllm",
  "args": [
    "serve",
    "/models/${name}",
    "--served-model-name",
    "${name}",
    "--host",
    "0.0.0.0",
    "--port",
    "8000",
    "--max-model-len",
    "${ctx}",
    "--max-num-seqs",
    "${seqs}",
    "--gpu-memory-utilization",
    "${mem}",
    "--kv-cache-dtype",
    "${kv}",
    "--enable-auto-tool-choice",
    "--tool-call-parser",
    "${tools}",
    "--reasoning-parser",
    "${think}",
    "${extra}"
  ],
  "shm": "16g",
  "weights_at": "/models/${name}",
  "defaults": {
    "ctx": 32768,
    "seqs": 1,
    "mem": 0.9,
    "kv": "auto",
    "tools": "inkling",
    "think": "inkling",
    "vision": false,
    "extra": ""
  }
}
