{
  "id": "sglang-exl3-offload",
  "engine": "sglang",
  "about": "SGLang 0.5.20 with EXL3 kernels and trellis-serve's MoE offload (the sglang-exl3-flashnext image, sm_86: every desktop and laptop RTX 30-series card): routed experts in page-locked host RAM behind a GPU expert cache sized to the VRAM left over, so MoE models larger than the card run on it",
  "image": "ghcr.io/0xsero/sglang-exl3-flashnext@sha256:ce47df25cee7ff235d8bfdf3e79e3828aa11bee3624db3ce121ebc79a8375dd3",
  "provenance": "https://github.com/0xSero/local-ai-images/actions/runs/36572531401",
  "backend": "nvidia",
  "min_cuda": 13.0,
  "port": 30000,
  "entrypoint": "/opt/entrypoint.sh",
  "args": [
    "python3",
    "-m",
    "sglang.launch_server",
    "--model-path",
    "/models/${name}",
    "--quantization",
    "exl3",
    "--trust-remote-code",
    "--host",
    "0.0.0.0",
    "--port",
    "30000",
    "--served-model-name",
    "${name}",
    "--disable-shared-experts-fusion",
    "--context-length",
    "${ctx}",
    "--mem-fraction-static",
    "${mem}",
    "--kv-cache-dtype",
    "${kv}",
    "--max-running-requests",
    "${seqs}",
    "--chunked-prefill-size",
    "${chunk}",
    "--cuda-graph-max-bs-decode",
    "${graphs}",
    "--cuda-graph-backend-prefill",
    "disabled",
    "--max-mamba-cache-size",
    "${mamba}",
    "--reasoning-parser",
    "${think}",
    "--tool-call-parser",
    "${tools}",
    "${extra}"
  ],
  "env": {
    "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
    "HF_HUB_OFFLINE": "1",
    "SGLANG_EXL3_MODEL_PATH": "/models/${name}",
    "SGLANG_EXL3_MOE_OFFLOAD": "gpu_cache",
    "SGLANG_EXL3_EXPERT_CACHE_GB": "${cache}",
    "EXL3_MOE_CPU_THREADS": "${threads}",
    "SGLANG_EXL3_EMBED_HOST": "1",
    "SGLANG_EXL3_OFFLOAD_STAGING_PARTS": "4",
    "SGLANG_EXL3_OFFLOAD_FUSED": "1",
    "SGLANG_EXL3_OFFLOAD_COMPACT_PARTS": "1",
    "SGLANG_EXL3_MOE_PREFILL_FP16_ACC": "1",
    "SGLANG_EXL3_NGRAM_TIER": "${ngram}",
    "SGLANG_EXL3_VISION": "${vision_env}",
    "SGLANG_EXL3_MM_FAST_CPU": "1",
    "SGLANG_EXL3_VIT_SDPA": "1",
    "SGLANG_EXL3_VIT_MLP_CHUNK": "8192"
  },
  "shm": "16g",
  "weights_at": "/models/${name}",
  "needs": {
    "host_ram_gb": "${ram}",
    "disk_gb": "${disk}",
    "fast_storage": "nvme"
  },
  "defaults": {
    "ctx": 65536,
    "seqs": 1,
    "mem": 0.85,
    "kv": "fp8_e4m3",
    "chunk": 4096,
    "graphs": 4,
    "mamba": 4,
    "tools": "qwen3_coder",
    "think": "qwen3",
    "vision": false,
    "vision_env": 0,
    "extra": "",
    "cache": "auto",
    "threads": 8,
    "ngram": "nvme",
    "ram": 75,
    "disk": 90,
    "pool": 0
  }
}
